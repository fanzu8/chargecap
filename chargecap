def find_spin(widget):
    """Depth-first search for the internal Gtk.SpinButton of an Adw.SpinRow."""
    child = widget.get_first_child()
    while child is not None:
        if isinstance(child, Gtk.SpinButton):
            return child
        found = find_spin(child)
        if found is not None:
            return found
        child = child.get_next_sibling()
    return None


def hug_title(row, also_subtitle=False):
    """Make a row's own labels hug their text.

    The key chip is a background on the label, so it has to wrap just the text.
    Adw stretches the title label across the whole header instead (the chip
    becomes a band and long titles like "USB类型" ellipsize), so those two
    labels get halign START -- 电流's "(mA)" subtitle rides along.
    """
    def walk(widget):
        if isinstance(widget, Gtk.Label):
            classes = widget.get_css_classes()
            if "title" in classes or (also_subtitle and "subtitle" in classes):
                widget.set_halign(Gtk.Align.START)
            if "subtitle" in classes:
                # a squeezed "(mA)" must ellipsize, not wrap into three lines
                widget.set_wrap(False)
                widget.set_ellipsize(Pango.EllipsizeMode.END)
        child = widget.get_first_child()
        while child is not None:
            walk(child)
            child = child.get_next_sibling()
    walk(row)


