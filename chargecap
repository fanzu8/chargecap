def _system_language():
    """'zh' or 'en', taken from the locale the session runs in."""
    try:
        names = GLib.get_language_names()
    except Exception:
        names = []
    for name in names:
        code = name.split(".")[0].split("_")[0].lower()
        if code in ("zh", "en"):
            return code
    return "en"


def _stored_language():
    """The language pushed by hand, or None when the system's is used.

    Read straight from ui.json because this runs at import time -- the strings
    are translated while the module is being built.
