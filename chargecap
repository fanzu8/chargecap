    def _on_language(self, item, want):
        if not item.get_active():
            return
        self._lang_pop.popdown()
        d = load_ui()
        if want == "auto":
            d.pop("lang", None)
        else:
            d["lang"] = want
        save_ui(d)
        effective = want if want in ("zh", "en") else _system_language()
        if effective != LANGUAGE:
            self._relaunch()

    def _relaunch(self):
        """Start a fresh panel once this process is gone.

        The strings are translated while the UI is being built, so a language
        change needs a new process -- but the app is single-instance, so the
        replacement has to wait until this one exits (otherwise it just
        activates the old instance and dies).
        """
        script = ("while kill -0 %d 2>/dev/null; do sleep 0.2; done; "
                  "exec %s %s" % (os.getpid(), shlex.quote(sys.executable),
                                  shlex.quote(os.path.abspath(__file__))))
        try:
            subprocess.Popen(["/bin/sh", "-c", script], start_new_session=True)
        except Exception:
            pass
        self.get_application().quit()

    def _on_metric_toggled(self, btn, key):
        if btn.get_active() and key not in self.chart.selected:
            # keep METRICS order so the Y axes never jump around
            self.chart.selected = [k for k in METRIC_KEYS
                                   if k in self.chart.selected or k == key]
        elif not btn.get_active() and key in self.chart.selected:
            self.chart.selected.remove(key)
        self.chart.queue_draw()
        self._save_ui()

    def _on_window_changed(self, row, _param):
        idx = row.get_selected()
        if 0 <= idx < len(WINDOWS):
            self.chart.window_secs = WINDOWS[idx][1]
            self.chart.queue_draw()
            self._save_ui()

    # ---- daemon/battery -> UI ----
    def refresh(self):
        now = time.monotonic()
        paint = now - self._painted_at >= SAMPLE_MS / 1000.0
        if paint:
            self._painted_at = now
        s = read_state()
        self._loading = True
        if s:
            if self._pending is not None:
                p = self._pending
                confirmed = (
                    bool(p["limit_enabled"]) == bool(s.get("limit_enabled"))
                    and p["upper"] == s.get("upper")
                    and p["lower"] == s.get("lower")
                    and p["current_limit"] == s.get("current_limit")
                    and bool(p["inhibit_sleep"]) == bool(s.get("inhibit_sleep")))
                if confirmed or (time.monotonic() - self._pending_at) > PENDING_TTL:
                    self._pending = None
            if self._pending is None:
                self.row_enable.set_active(bool(s.get("limit_enabled", True)))
                self.row_upper.set_value(s.get("upper", 50))
                self.row_lower.set_value(s.get("lower", 45))
                self.row_inhibit.set_active(bool(s.get("inhibit_sleep", True)))
                lim = s.get("current_limit")
                if lim:
                    self.spin_limit.set_value(int(lim))
            self.row_enable.set_sensitive(True)
            en = self.row_enable.get_active()
            self.row_upper.set_sensitive(en)
            self.row_lower.set_sensitive(en)
            self.row_inhibit.set_sensitive(True)
            self.spin_limit.set_sensitive(True)
        else:
            for r in (self.row_enable, self.row_upper,
                      self.row_lower, self.row_inhibit):
                r.set_sensitive(False)
            self.spin_limit.set_sensitive(False)
        self._loading = False

        # keep the status columns proportional to the real width
        w = min(self.get_width(), self._screen_width() or self.get_width())
        if w != self._last_w:
            self._last_w = w
            self._apply_col_widths()

        # live battery metrics straight from sysfs
        cap = read_int(os.path.join(BAT, "capacity"))
        raw_v = read_int(os.path.join(BAT, "voltage_now"))
        raw_i = read_int(os.path.join(BAT, "current_now"))
        raw_t = read_int(os.path.join(BAT, "temp"))
        st = read_str(os.path.join(BAT, "status"))
        online = read_int(os.path.join(CHG, "online"))

        self.f["capacity"].set_text(f"{cap}%" if cap is not None else "—")
        charging = (st == "Charging")
        self.f["status"].set_text(_("充电中") if charging else _("未充电"))
        set_charge_class(self.f["status"], charging)

        plugged = (online == 1) or bool(s and s.get("plugged"))
        self.f["plugged"].set_text(_("已连接") if plugged else _("未连接"))
        set_charge_class(self.f["plugged"], plugged)

        v = raw_v / 1e6 if raw_v is not None else None
        i = raw_i / 1e6 if raw_i is not None else None
        t = raw_t / 10.0 if raw_t is not None else None
        self.f["voltage_v"].set_text(f"{v:.3f}" if v is not None else "—")
        self.f["power_w"].set_text(
            f"{v * i:+.2f}" if (v is not None and i is not None) else "—")
        self.f["temp_c"].set_text(f"{t:.1f}" if t is not None else "—")

        # charger type: the driver falls back to Unknown whenever no input is
        # attached, so remember the last real one and keep showing it while the
        # input is held off
        ut = read_usb_type()
        if ut and ut != "Unknown":
            self._usb_type = ut
        elif plugged and self._usb_type:
            ut = self._usb_type
        self.f["usb_type"].set_text(USB_TYPE_ZH.get(ut, ut) if ut else "—")

        # capacity: what it holds now / the design value, and the health
        # percentage that follows from the two
        full = read_int(os.path.join(BAT, "charge_full"))
        design = read_int(os.path.join(BAT, "charge_full_design"))
        self.f["charge_full"].set_text(
            f"{full / 1000:.0f}/{design / 1000:.0f}"
            if (full and design) else "—")
        self.f["health"].set_text(
            f"{full / design * 100:.0f}%" if (full and design) else "—")

        # input current: the gauge's rated maximum (read-only).  It also caps
        # the writable limit: the spin's upper bound follows it, so a larger
        # number can neither be typed nor stepped to.
        cc = read_int(os.path.join(BAT, "constant_charge_current_max"))
        self.f["current_max"].set_text(f"{cc // 1000}" if cc else "—")
        if cc:
            mx = max(100, cc // 1000)
            adj = self.spin_limit.get_adjustment()
            if int(adj.get_upper()) != mx:
                self._loading = True
                adj.set_upper(mx)
                if self.spin_limit.get_value() > mx:
                    self.spin_limit.set_value(mx)
                self._loading = False

        # current: signed, track min/max (reset each time the app opens)
        if raw_i is not None:
            cur = raw_i / 1000.0
            self.i_min = cur if self.i_min is None else min(self.i_min, cur)
            self.i_max = cur if self.i_max is None else max(self.i_max, cur)
            self.f["current_a"].set_text(f"{cur:+.0f}")
            self.f["current_range"].set_text(
                f"{self.i_min:.0f} | {self.i_max:.0f}")
        else:
            self.f["current_a"].set_text("—")
            self.f["current_range"].set_text("—")

        # the 电流 row's left half is sized from that live text
        if self._cur_cells is not None:
            self._apply_col_widths()

        # feed the chart on its own clock; the panel above follows the 500 ms
        # power is plotted as a magnitude: it tracks the current's shape almost
        # exactly (P = V·I, V nearly constant), so keeping its sign on top of
        # the current's would just make the two curves overlap.
        if self._sample_due(now):
            self._stored_at = now
            self.chart.add_sample({
                "voltage_v": v,
                "current_mA": raw_i / 1000.0 if raw_i is not None else None,
                "power_w": abs(v * i) if (v is not None and i is not None)
                else None,
                "temp_c": t,
                "capacity": float(cap) if cap is not None else None,
            })
        if paint:
            self.chart.queue_draw()
        # the interval can change while we run, so ask to be woken at its pace
        GLib.timeout_add(self._tick_ms(), self.refresh)
        return False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.postmarketos.Chargecap", flags=0)
        # the background is chosen before the window is built, so the panel
        # opens in it instead of flashing the other scheme first
        apply_scheme(SCHEME_CHOICE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = Window(self)
        win.present()


if __name__ == "__main__":
    App().run(None)
