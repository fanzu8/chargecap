        self._sample_pop = pop
        btn.set_popover(pop)
        return btn

    def _on_sample(self, item, want):
        """The recording interval changed: remember it and wake up at its pace."""
        global SAMPLE_MS_CHOICE
        if not item.get_active() or want not in [ms for _l, ms in SAMPLES]:
            return
        self._sample_pop.popdown()
        SAMPLE_MS_CHOICE = want
        d = load_ui()
        d["sample_ms"] = want
        save_ui(d)
        self._sample_label.set_text(sample_label() + "  \u25be")


