    # ---- sampling ----
    def _tick_ms(self):
        """How often to wake up: the interval, or the panel's own 500 ms."""
        return max(10, min(SAMPLE_MS, SAMPLE_MS_CHOICE))

    def _sample_due(self, now):
        """True when the chart's clock says a sample is due."""
        return (SAMPLE_MS_CHOICE <= SAMPLE_MS
                or now - self._stored_at >= SAMPLE_MS_CHOICE / 1000.0)

    def _sample_button(self):
        """The recording interval, right after the states.

        A compact chip carrying the same chevron 窗口's value has: the row is one
        phone screen wide and a full dropdown here pushed the values into
