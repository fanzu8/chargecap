        g_chart.add(row_chart)
        page.add(g_chart)
        self._chart_ready = True

        # react to the shell resizing us (rotation) instead of waiting for the
        # next refresh tick
        self.connect("notify::width", self._on_resized)
        # A rotation can resize the output while our own size requests keep the
        # window from shrinking back with it, so react to the monitor changing
        # as well and recompute the columns from the new geometry.
        try:
            self.get_display().connect(
                "monitors-changed", lambda *_: self._on_monitors_changed())
        except Exception:
            pass

        self._stored_at = 0.0
        self._painted_at = 0.0
        # refresh() re-arms this itself, at whatever interval is set: one clock,
        # so the panel can stay at 500 ms while the chart records slower
        self.refresh()

    # ---- responsive status columns ----
    def _screen_width(self):
        """Logical width of the monitor, or 0 when it cannot be read."""
        try:
            mon = self.get_display().get_monitors().get_item(0)
            geo = mon.get_geometry()
            if geo.width > 1:
                return geo.width
        except Exception:
            pass
        return 0

    def _page_cap(self):
        """The content width cap the Adw page applies, or 0 when unknown.

        AdwPreferencesPage puts its content in an Adw.Clamp; on a wide screen
        (landscape) that is what limits the rows, not the window.  Reading the
        cap keeps the column model in step with the real page width without
        asking the widgets how wide they turned out (which would let the
        size requests feed back into their own measurement).
        """
        if self._clamp_max:
            return self._clamp_max
        def find(widget):
            if type(widget).__name__ == "Clamp":
                return widget
            child = widget.get_first_child()
            while child is not None:
                found = find(child)
                if found is not None:
                    return found
                child = child.get_next_sibling()
            return None
        clamp = find(self)
        if clamp is not None:
            try:
                self._clamp_max = int(clamp.get_maximum_size())
            except Exception:
                self._clamp_max = 0
        return self._clamp_max

    def _cell_widths(self, n):
        """Size requests for a row of n cells (values and inline labels).

        Every cell but the last takes one of the shared columns, so values and
        labels line up from row to row; the last cell takes the rest, which
        keeps the widest tail value (the current range, say) from ellipsizing.
        """
        base = self._suffix_w - (MAX_CELLS - 1) * COL_SPACING
        ws = [int(base * f) for f in COL_FRACS[:n - 1]]
        ws.append(max(40, self._suffix_w - sum(ws) - (n - 1) * COL_SPACING))
        return ws

    def _apply_col_widths(self):
        # The shell forces the window to the screen size, but these columns set
        # a hard minimum width through set_size_request(), so the window can
        # refuse to shrink.  Read the width from the monitor as well and keep
        # the smaller of the two: the monitor always follows a rotation, so
        # rotating back to portrait really recomputes the columns instead of
        # keeping the landscape sizes and overflowing the screen.
        w = self.get_width()
        mw = self._screen_width()
        if mw > 1:
            w = mw if w <= 1 else min(w, mw)
        if w <= 1:
            w = 320
        # The Adw page clamps its content (landscape gives the window a lot of
        # width the rows never see: the rows were 684px wide on a 760px window,
        # which squeezed every status title into "…").  Clamp to the cap the
        # page really applies -- the clamp's own maximum -- so the columns are
        # never wider than the rows.  It only ever makes the columns narrower,
        # so a wrong guess costs a little slack in the title gutter.
        cap = self._page_cap()
        if cap > 1:
            w = min(w, cap)
        # page side margins only: the row's own padding is zeroed in the CSS
        inner = max(120, w - PAGE_MARGIN)
        # reserve room for the widest row title, measured from real text, so
        # the title is never squeezed into an ellipsis by a wide value column.
        # The chip behind a title adds its own padding, which the plain text
        # measurement does not include (English titles are wide enough that
        # missing it showed up as "Voltag…").
        if self._title_w <= 0:
            m = 0
            for t in self._title_texts:
                try:
                    m = max(m, self.create_pango_layout(t).get_pixel_size()[0])
                except Exception:
                    pass
            self._title_w = (m or 40) + TITLE_CHIP_PAD
        self._suffix_w = max(80, inner - (int(self._title_w) + TITLE_GAP))
        # never demand more width than a portrait screen can hold, or the
        # window's minimum keeps the shell from shrinking us (see MAX_SUFFIX)
        self._suffix_w = min(self._suffix_w, MAX_SUFFIX)
        if os.environ.get("CL_DEBUG"):
            # diagnosis only (CL_DEBUG=1): what the window's own minimum is,
            # next to the numbers the model uses
            try:
                res = self.measure(Gtk.Orientation.HORIZONTAL, -1)
                wmin = res[0] if isinstance(res, tuple) else res
            except Exception:
                wmin = -1
            key = (self.get_width(), mw, wmin, int(self._suffix_w))
            if key != self._dbg_key:
                self._dbg_key = key
                print("[cl] win=%s win_min=%s screen=%s clamp=%s inner=%s "
                      "suffix=%s max=%s full=%s" % (
                          self.get_width(), wmin, mw, self._page_cap(),
                          inner, self._suffix_w, self.is_maximized(),
                          self.is_fullscreen()), flush=True)
        for cells in self._cols:
            for cell, cw in zip(cells, self._cell_widths(len(cells))):
                cell.set_size_request(cw, -1)
        # 电流: the left half is as narrow as its own content, so 限制 / 最大
        # start as far left as they can.  The width follows the live text of
        # "极值 ..." -- i_min/i_max only ever widen, so it moves rarely.
        if self._cur_cells is not None:
            left = 60
            for cell_w in (self._cur_cells[0], self._cur_cells[2]):
                try:
                    res = cell_w.measure(Gtk.Orientation.HORIZONTAL, -1)
                    left = max(left, (res[1] if isinstance(res, tuple) else res))
                except Exception:
                    pass
            # the spin keeps its own minimum (the number + the two buttons);
            # the budget is measured, not guessed: 4 digits + 2 buttons ≈ 100px
            left = min(int(left), max(60, self._suffix_w - 100 - CUR_GAP))
            self._cur_cells[0].set_size_request(left, -1)
            self._cur_cells[1].set_size_request(
                max(48, self._suffix_w - left - CUR_GAP), -1)
        # rows with spread values just need the same cell area
        for box in self._spread:
            box.set_size_request(self._suffix_w, -1)

    def _on_resized(self, *_):
        if self._cols:
            self._apply_col_widths()

    def _on_monitors_changed(self):
        """The output rotated: recompute even if we were not resized."""
        self._last_w = -1
        if self._cols:
            self._apply_col_widths()

    def _spin_output(self, spin):
        spin.set_text(f"{int(round(spin.get_value()))}%")
        return True

    # ---- UI -> daemon ----
    def _send(self):
        if self._loading:
            return
        payload = {
            "command": "set",
            "limit_enabled": bool(self.row_enable.get_active()),
            "upper": int(self.row_upper.get_value()),
            "lower": int(self.row_lower.get_value()),
            "inhibit_sleep": bool(self.row_inhibit.get_active()),
            "current_limit": int(self.spin_limit.get_value()),
        }
        send_request(payload)
        self._pending = payload
        self._pending_at = time.monotonic()

    def _on_changed(self, *_):
        self._send()

    def _on_limit_changed(self, *_):
        self._send()

    def _on_upper_changed(self, *_):
        if self._loading:
            return
        up = int(self.row_upper.get_value())
        lo = int(self.row_lower.get_value())
        if lo > up - MIN_GAP:                     # keep 下限 at least 2 below 上限
            self._loading = True
            self.row_lower.set_value(max(5, up - MIN_GAP))
            self._loading = False
        self._send()

    def _on_lower_changed(self, *_):
        if self._loading:
            return
        up = int(self.row_upper.get_value())
        lo = int(self.row_lower.get_value())
        if lo > up - MIN_GAP:                     # push 上限 up to keep the gap
            self._loading = True
            self.row_upper.set_value(min(100, lo + MIN_GAP))
            self._loading = False
        self._send()

