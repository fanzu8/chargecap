def metric_css():
    """One colour class per metric: .m-<key> colours a widget, .mt-<key>
    colours the title of a row (the row's own class must not carry the colour,
    or it would be inherited by every label inside it).  The 指标 buttons get
    their colour only while they are selected, plus a background tint in the
    same colour."""
    out = []
    for key, _name, _unit, color, _fmt, _side, _rng in METRICS:
        bright = METRIC_BRIGHT.get(key, color)
        out.append(f".m-{key} {{ color: {color}; }}")
        out.append(f".mt-{key} .title {{ color: {color}; }}")
        # the unit line under a title takes the same colour as the title
        out.append(f".mt-{key} .subtitle {{ color: {color}; }}")
        out.append(f"button.metric-btn.k-{key}:checked {{"
                   f" color: {bright};"
                   f" background-color: alpha({color}, 0.30); }}")
    # the number in the writable-limit spin button is a 电流 value: same red,
    # without colouring the spin's own buttons
    out.append("spinbutton.limit-spin text { color: "
               f"{METRIC_INFO['current_mA'][3]}; }}")
    return "\n".join(out)


