def send_request(payload):
    os.makedirs(os.path.dirname(REQUEST), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(REQUEST), prefix=".req-")
    with os.fdopen(fd, "w") as f:
        json.dump(payload, f)
    os.replace(tmp, REQUEST)


def read_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return None


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except Exception:
        return None


def read_str(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return None


