def read_usb_type():
    """Currently detected charger type, e.g. "DCP"."""
    s = read_str(os.path.join(CHG, "usb_type"))
    if not s:
        return None
    m = re.search(r"\[([^\]]+)\]", s)
    if m:
        return m.group(1)
    tok = s.split()
    return tok[0] if tok else None


def cell(xalign=0.0):
    lbl = Gtk.Label()
    lbl.set_xalign(xalign)
    lbl.set_halign(Gtk.Align.FILL)
    lbl.set_wrap(False)
    lbl.set_ellipsize(Pango.EllipsizeMode.END)
    return lbl


def key_label(text, colour=None, small=False):
