        """
        btn = Gtk.MenuButton()
        btn.add_css_class("flat")
        btn.add_css_class("lang-btn")
        self._sample_label = Gtk.Label(label=sample_label() + "  \u25be")
        self._sample_label.add_css_class("sample-value")
        btn.set_child(self._sample_label)
        btn.set_tooltip_text(_("采样间隔"))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
