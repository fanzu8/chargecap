# about an hour, 20 s keeps weeks).
SAMPLES = (("0.01s", 10), ("0.03s", 30), ("0.05s", 50), ("0.1s", 100),
           ("0.3s", 300), ("0.5s", 500), ("1s", 1000), ("2s", 2000),
           ("3s", 3000), ("5s", 5000), ("10s", 10000), ("15s", 15000),
           ("20s", 20000))
SAMPLE_MS = 500          # the panel's own readout, and a fresh install's rate


def stored_sample_ms():
    """The recording interval pushed by hand, in milliseconds."""
    try:
        with open(UI_FILE) as f:
            want = (json.load(f) or {}).get("sample_ms")
    except Exception:
        want = None
    return want if want in [ms for _label, ms in SAMPLES] else SAMPLE_MS


SAMPLE_MS_CHOICE = stored_sample_ms()


def sample_label():
    for label, ms in SAMPLES:
        if ms == SAMPLE_MS_CHOICE:
            return label
    return "0.5s"
# samples kept for the longest window (48 h at 2 Hz), plus a little slack
MAX_SAMPLES = 48 * 3600 * 1000 // SAMPLE_MS + 16

def load_ui():
    try:
        with open(UI_FILE) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def save_ui(d):
    try:
        os.makedirs(os.path.dirname(UI_FILE), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(UI_FILE), prefix=".ui-")
        with os.fdopen(fd, "w") as f:
            json.dump(d, f)
        os.replace(tmp, UI_FILE)
    except Exception:
        pass


def _rgb(hex_color):
    h = hex_color.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


class LiveChart(Gtk.DrawingArea):
    """Overlays the selected metrics on one rolling chart.

    Every selected curve is auto-scaled to its own min/max so its trend stays
    visible; its Y ticks are drawn on the left or right edge in the curve's own
    colour.  Samples live in memory only and disappear when the app closes.
    """

    COL_W = 30          # width of one Y-axis column (name / unit / ticks)
    PAD_X = 4           # gap between the plot and the nearest tick column
    PAD_T, PAD_B = 26, 13   # top leaves room for the two-line axis header
    PTS_PER_PX = 2      # decimation cap: at most 2 drawn points per pixel
    LINE_W = 0.6        # curve thickness
    GRID_W = 0.5        # grid must stay thinner than the curves
    TICKS = (0.0, 0.25, 0.5, 0.75, 1.0)     # 5 divisions, grid lines on them
    GRID_DIVS = 5       # divisions of the time axis
    GRID_RGBA = (0.5, 0.5, 0.5, 0.10)       # faint: it stays under the curves
    _LH = 0             # cached line height of the axis font

    def __init__(self):
        super().__init__()
        self.set_size_request(-1, 139)   # +15px, as asked
        self.set_hexpand(True)
        self.set_draw_func(self._draw)
        self.selected = []          # selected metric keys, in METRICS order
        self.window_secs = 60
        # arrays instead of lists: a 48 h window is 345k samples per metric,
        # which would be ~50 MB as boxed Python floats and ~14 MB as doubles
        self._ts = array("d")       # shared timestamps (monotonic)
        self._data = {k: array("d") for k in METRIC_KEYS}
        self._font = Pango.FontDescription("Sans")
        # a small font keeps the tick columns narrow so the plot stays wide
        self._font.set_absolute_size(8 * Pango.SCALE)

    # ---- data ----
    def add_sample(self, values):
        """values: {key: float|None}; called from the UI refresh timer."""
        self._ts.append(time.monotonic())
        for k in METRIC_KEYS:
            v = values.get(k)
            self._data[k].append(float("nan") if v is None else float(v))
        if len(self._ts) > MAX_SAMPLES:
            drop = len(self._ts) - MAX_SAMPLES
            del self._ts[:drop]
            for k in METRIC_KEYS:
                del self._data[k][:drop]

    def _series(self, key, cutoff):
        """Visible (t, v) pairs for one metric, starting at `cutoff`.

        Points are picked with a stride instead of building them all first and
        thinning afterwards, so a 48 h window costs the same as a 30 s one.
        """
        ts, vs = self._ts, self._data[key]
        i = bisect.bisect_left(ts, cutoff)
        n = len(ts) - i
        if n <= 0:
            return []
        step = max(1, n // max(2, int(self.get_width() * self.PTS_PER_PX)))
        out = [(ts[j], vs[j]) for j in range(i, len(ts), step) if vs[j] == vs[j]]
        last = len(vs) - 1
        if vs[last] == vs[last] and (not out or out[-1][0] != ts[last]):
            out.append((ts[last], vs[last]))
        return out

    # ---- drawing ----
    def _text(self, cr, x, y, s, rgb, align="left"):
        """Draw `s` with Pango at top-left (x, y), shifted by `align`."""
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(self._font)
        layout.set_text(s, -1)
        w, h = layout.get_pixel_size()
        if align == "right":
            x -= w
        elif align == "center":
            x -= w / 2
        cr.set_source_rgb(*rgb)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)
        return w, h

    def _line_height(self, cr):
        """Height of one line of the axis font (measured once, off-screen)."""
        if not LiveChart._LH:
            LiveChart._LH = self._text(cr, -200, -200, "0", (0, 0, 0))[1]
        return LiveChart._LH

    def _measure(self, cr, s):
        """Width of `s` in the axis font, without drawing it."""
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(self._font)
        layout.set_text(s, -1)
        return layout.get_pixel_size()[0]

    def _draw(self, _area, cr, width, height):
        sel = [k for k in METRIC_KEYS if k in self.selected]
        if not sel:
            self._text(cr, width / 2, height / 2, _("选择上方指标以显示曲线"),
                       (0.55, 0.55, 0.55), "center")
            return

        left = [k for k in sel if METRIC_INFO[k][5] == "left"]
        right = [k for k in sel if METRIC_INFO[k][5] == "right"]
        ml = self.PAD_X + self.COL_W * len(left)
        mr = self.PAD_X + self.COL_W * len(right)
        pw = max(10, width - ml - mr)
        ph = max(10, height - self.PAD_T - self.PAD_B)
        top, bottom = self.PAD_T, self.PAD_T + ph
        now = time.monotonic()
        cutoff = now - self.window_secs
        span = max(1e-6, now - cutoff)

        # plot frame
        cr.set_source_rgba(0.5, 0.5, 0.5, 0.35)
        cr.set_line_width(1)
        cr.rectangle(ml + .5, top + .5, pw - 1, ph - 1)
        cr.stroke()

        # grid: only on the tick marks, five divisions each way, very faint
        cr.set_source_rgba(*self.GRID_RGBA)
        cr.set_line_width(self.GRID_W)
        for f in self.TICKS[1:-1]:
            y = bottom - f * ph
            cr.move_to(ml, y)
            cr.line_to(ml + pw, y)
        for i in range(1, self.GRID_DIVS):
            x = ml + pw * i / self.GRID_DIVS
            cr.move_to(x, top)
            cr.line_to(x, bottom)
        cr.stroke()

        for key in sel:
            _k, name, unit, color, fmt, side, fixed = METRIC_INFO[key]
            name = metric_axis_label(key, name)
            rgb = _rgb(color)
            pts = self._series(key, cutoff)
            if not pts:
                continue
            if fixed:
                lo, hi = fixed
            else:
                vals = [v for _, v in pts]
                lo, hi = min(vals), max(vals)
                pad = (hi - lo) * 0.1
                lo, hi = lo - pad, hi + pad
                if hi - lo < 1e-9:
                    lo, hi = lo - 0.5, hi + 0.5
            scale = ph / (hi - lo)

            # the curve
            cr.set_source_rgb(*rgb)
            cr.set_line_width(self.LINE_W)
            for n, (t, v) in enumerate(pts):
                x = ml + pw * (t - cutoff) / span
                y = bottom - (v - lo) * scale
                if n == 0:
                    cr.move_to(x, y)
                else:
                    cr.line_to(x, y)
            cr.stroke()

            # this curve's own Y axis, on its fixed side: name over unit, then
            # five ticks down the side of the plot (the same divisions the grid
            # lines use).  Columns are packed from the plot outwards, so gaps
            # never appear between them.
            col = (left if side == "left" else right).index(key)
            if side == "left":
                ax, align = ml - self.PAD_X - self.COL_W * col, "right"
            else:
                ax, align = width - mr + self.PAD_X + self.COL_W * col, "left"
            lh = self._line_height(cr)
            self._text(cr, ax, 0, name, rgb, align)
            self._text(cr, ax, lh, unit, rgb, align)
            for f in self.TICKS:
                if f >= 1.0:
                    y = top + 1
                elif f <= 0.0:
                    y = bottom - lh - 1
                else:
                    y = bottom - f * ph - lh / 2
                self._text(cr, ax, y, fmt.format(lo + f * (hi - lo)), rgb, align)

        # time axis: a label on every division, so the spacing reads as even.
        # A label that would touch its neighbour is left out, which only
        # happens on a very narrow plot or a very long window.
        dim = (0.55, 0.55, 0.55)
        th = self._line_height(cr)
        prev_start = None
        for f in reversed(self.TICKS):
            s = self._fmt_offset(self.window_secs * (1.0 - f))
            w = self._measure(cr, s)
            x = max(ml, min(ml + pw * f - w / 2, ml + pw - w))
            if prev_start is not None and x + w > prev_start - 6:
                continue
            self._text(cr, x, height - th, s, dim, "left")
            prev_start = x

    @staticmethod
    def _fmt_offset(secs):
        """A time offset as M:SS (under an hour) or H:MM, plus 现在 at zero.

        One shape for the whole axis: the window's own dropdown says which of
        the two units a chart is using.
        """
        if secs < 0.5:
            return _("现在")
        total = int(secs + 0.5)
        if total < 3600:
            return f"-{total // 60}:{total % 60:02d}"
        return f"-{total // 3600}:{total % 3600 // 60:02d}"


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=_("电电"))
        self.set_default_size(360, 720)
        self._loading = False
        # signed current extremes, reset every time the window opens
        self.i_min = None
        self.i_max = None
        # last charger type the driver really reported (it says Unknown when
        # no input is attached)
        self._usb_type = None
        # setting we just changed, waiting for the daemon to confirm it
        self._pending = None
        self._pending_at = 0.0
        self._cols = []          # one tuple of cells per status row
        # the 电流 row is a 2x2 block with its own two widths (left / right half)
        self._cur_cells = None
        self._title_texts = []   # row titles, used to size the title reserve
        self._title_w = 0
        self._suffix_w = 200     # width of the area right of the row titles
        self._clamp_max = 0      # the page's content cap (read from Adw.Clamp)
        self._last_w = -1
        self._dbg_key = None      # CL_DEBUG=1 prints on change only
        self._chart_ready = False   # guard while restoring the saved chart prefs

        provider = Gtk.CssProvider()
        provider.load_from_string(CSS + metric_css() + scale_css())
        disp = self.get_display() or Gdk.Display.get_default()
        if disp is not None:
            Gtk.StyleContext.add_provider_for_display(
                disp, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        tv = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.pack_end(self._language_button())
        # pack_end puts each button left of the last one, so the background
        # switch ends up before the language one, as in the Android app
        header.pack_end(self._background_button())
        tv.add_top_bar(header)
        page = Adw.PreferencesPage()
        tv.set_content(page)
        self.set_content(tv)

        # ---- limits ----
        # only 限制充电 carries a note; 上限 / 下限 are self-explanatory and the
        # rows stay as compact as the status rows below
        # no group title: the switch below says what the box is for
        g_lim = Adw.PreferencesGroup()
        self.row_enable = Adw.SwitchRow(
            title=_("限制充电"),
            subtitle=_("达上限停止充电，降到下限恢复充电，区间滞回"))
        g_lim.add(self.row_enable)
        self.row_upper = Adw.SpinRow(
            title=_("上限"),
            adjustment=Gtk.Adjustment(value=50, lower=5, upper=100, step_increment=1))
        self.row_lower = Adw.SpinRow(
            title=_("下限"),
            adjustment=Gtk.Adjustment(value=45, lower=5, upper=100, step_increment=1))
        g_lim.add(self.row_upper)
        g_lim.add(self.row_lower)
        for row in (self.row_enable, self.row_upper, self.row_lower):
            row.add_css_class("compact-status")
        self.row_enable.add_css_class("switch-row")
        # the key chip has to wrap the text, not the whole row
        hug_title(self.row_enable)
        page.add(g_lim)

        # show the unit on the spin value ("70%")
        for row in (self.row_upper, self.row_lower):
            spin = find_spin(row)
            if spin is not None:
                spin.connect("output", self._spin_output)

        self.row_enable.connect("notify::active", self._on_changed)
        self.row_upper.connect("notify::value", self._on_upper_changed)
        self.row_lower.connect("notify::value", self._on_lower_changed)

        # ---- power ----
        # 无标题分组：只保留「禁止休眠」这一行，再无用的标题占位
        g_pow = Adw.PreferencesGroup()
        self.row_inhibit = Adw.SwitchRow(
            title=_("禁止休眠"),
            subtitle=_("系统不休眠，保持网络在线"))
        self.row_inhibit.add_css_class("compact-status")
        self.row_inhibit.add_css_class("switch-row")
        hug_title(self.row_inhibit)
        g_pow.add(self.row_inhibit)
        page.add(g_pow)
        self.row_inhibit.connect("notify::active", self._on_changed)

        # ---- status: proportional columns, compact rows ----
        # no group title: the rows speak for themselves and every pixel of
        # height counts on a phone screen
        self.group_status = Adw.PreferencesGroup()
        self.f = {}
        self._spread = []        # rows whose values are spread evenly
        self.spin_limit = None   # writable USB input current limit (mA)

        def info_row(items, resizable=True):
            """Add one status row.

            items is a tuple of (label, field, colour[, extra]): the first label
            becomes the row title in the left gutter, the others label the values
            that follow it.  colour names a metric (or is None) and tints both
            the label and its value with that metric's curve colour.  `extra` is
            a widget that rides to the right of the value (the USB help button);
            when `field` is None the value label is left out and `extra` becomes
            the value cell itself (the writable current limit).

            Only resizable rows take part in the shared columns and in the title
            gutter: the capacity row at the bottom has a long title of its own
            and sizes to its content instead.
            """
            row = Adw.ActionRow(title=items[0][0])
            row.set_title_lines(1)
            row.add_css_class("compact-status")
            row.add_css_class("key-chip")
            hug_title(row)
            if items[0][2]:
                # colour the title through the row, so it is not inherited
                # by the values
                row.add_css_class(f"mt-{items[0][2]}")
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                          spacing=COL_SPACING)
            box.set_valign(Gtk.Align.CENTER)
            cells = []
            for n, item in enumerate(items):
                label, field, colour = item[0], item[1], item[2]
                extra = item[3] if len(item) > 3 else None
                if n:
                    # an inline key: bold and a touch dimmer, so it reads as a
                    # name and not as another value
                    lab = key_label(label, colour)
                    box.append(lab)
                    cells.append(lab)
                if field is None:
                    node = extra
                else:
                    # every value hugs the left edge of its cell, so the values
                    # of a column start at the same place down the panel
                    val = cell(xalign=0.0)
                    if colour:
                        val.add_css_class(f"m-{colour}")
                    self.f[field] = val
                    if extra is None:
                        node = val
                    else:
                        # value first, then the extra widget, in one cell
                        node = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                                       spacing=4)
                        node.set_valign(Gtk.Align.CENTER)
                        node.append(val)
                        node.append(extra)
                box.append(node)
                cells.append(node)
            row.add_suffix(box)
            self.group_status.add(row)
            if resizable:
                self._title_texts.append(items[0][0])
                self._cols.append(tuple(cells))

        def spread_row(title, items):
            """A row of bare values spread evenly across the row."""
            row = Adw.ActionRow(title=title)
            row.set_title_lines(1)
            row.add_css_class("compact-status")
            row.add_css_class("key-chip")
            hug_title(row)
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            box.set_homogeneous(True)     # equal thirds
            box.set_valign(Gtk.Align.CENTER)
            for field, colour in items:
                val = cell(xalign=0.0)   # left-aligned in its third
                if colour:
                    val.add_css_class(f"m-{colour}")
                box.append(val)
                self.f[field] = val
            row.add_suffix(box)
            self.group_status.add(row)
            self._title_texts.append(title)
            # keep the columns in step with the other rows' cell area
            self._spread.append(box)

        # 电源: three bare values, no keys.  已连接 / 充电中 green,
        # 未连接 / 未充电 yellow, 电量 plain.  They hug the left instead of
        # spreading out -- the gaps did nothing, and the room they free is
        # where the chart's recording interval goes.
        self._power_row()

        # USB 类型 with a help button, then 温度 on the same row
        help_btn = Gtk.MenuButton()
        help_icon = Gtk.Image.new_from_icon_name("help-about-symbolic")
        help_icon.set_pixel_size(10)     # a hint, not a button-sized target
        help_btn.set_child(help_icon)
        help_btn.set_has_frame(False)
        help_btn.add_css_class("info-btn")
        help_btn.set_valign(Gtk.Align.CENTER)
        help_btn.set_tooltip_text(_("USB 类型说明"))
        tip = Gtk.Label(label=USB_TYPE_HELP)
        tip.add_css_class("pop-tip")
        tip.set_xalign(0.0)
        tip.set_margin_start(12)
        tip.set_margin_end(12)
        tip.set_margin_top(10)
        tip.set_margin_bottom(10)
        pop = Gtk.Popover()
        pop.set_child(tip)
        # it says what SDP / DCP / CDP mean and then gets out of the way
        pop.connect("map", lambda *_: GLib.timeout_add(HINT_MS, pop.popdown))
        self._info_pop = pop
        help_btn.set_popover(pop)
        info_row(((_("USB类型"), "usb_type", None, help_btn),
                  (_("温度(°C)"), "temp_c", "temp_c")))

        info_row(((_("电压(V)"), "voltage_v", "voltage_v"),
                  (_("功率(W)"), "power_w", "power_w")))
        # 电流: the reading and its extremes on top, the rated maximum and the
        # writable limit below.  Both lines share one set of columns, so the
        # whole block reads as a single item instead of two separate rows.
        self.spin_limit = Gtk.SpinButton(
            adjustment=Gtk.Adjustment(value=0, lower=0, upper=1800,
                                      step_increment=100, page_increment=500))
        self.spin_limit.set_numeric(True)
        self.spin_limit.set_width_chars(2)
        self.spin_limit.set_valign(Gtk.Align.CENTER)
        self.spin_limit.add_css_class("limit-spin")
        self.spin_limit.connect("value-changed", self._on_limit_changed)

        def current_row():
            """电流 as one item: values on the left, limits on the right.

            电流 / 限制 on the first line, 极值 / 最大 under them, so the two
            halves read as one block instead of two separate rows.
            """
            # the unit sits on a second line so the title column stays as
            # narrow as the other rows' instead of pushing the values right
            row = Adw.ActionRow(title=_("电流"))
            row.set_subtitle("(mA)")
            row.set_title_lines(1)
            row.add_css_class("compact-status")
            row.add_css_class("key-chip")
            row.add_css_class("unit-row")
            row.add_css_class("mt-current_mA")
            hug_title(row, also_subtitle=True)
            grid = Gtk.Grid()
            grid.set_column_spacing(CUR_GAP)
            grid.set_row_spacing(2)
            grid.set_valign(Gtk.Align.CENTER)

            def key(text):
                """An inline key: the row's red, bold, one size smaller."""
                return key_label(text, "current_mA", small=True)

            def pair(key_text, node):
                """A key with its value right after it, packed left."""
                box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
                box.set_valign(Gtk.Align.CENTER)
                box.append(key(key_text))
                box.append(node)
                return box

            reading = cell(xalign=0.0)
            reading.add_css_class("m-current_mA")
            self.f["current_a"] = reading
            grid.attach(reading, 0, 0, 1, 1)

            # the three secondary values share one size and one colour: the row's
            # own red, at full strength
            def small_value():
                lbl = cell(xalign=0.0)
                lbl.add_css_class("m-current_mA")
                lbl.add_css_class("small-label")
                return lbl

            rng = small_value()
            self.f["current_range"] = rng
            box_rng = pair(_("极值"), rng)
            grid.attach(box_rng, 0, 1, 1, 1)

            val_max = small_value()
            self.f["current_max"] = val_max
            box_max = pair(_("最大"), val_max)
            grid.attach(box_max, 1, 1, 1, 1)

            # 限制 hugs the left of the right half and the spin takes the space
            # that frees up, so the control never looks squeezed
            box_lim = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            box_lim.set_valign(Gtk.Align.CENTER)
            box_lim.append(key(_("限制")))
            self.spin_limit.set_hexpand(True)
            box_lim.append(self.spin_limit)
            grid.attach(box_lim, 1, 0, 1, 1)

            row.add_suffix(grid)
            self.group_status.add(row)
            self._title_texts.append(_("电流"))
            # one size driver per column: these two cells fix the two widths
            self._cur_cells = (reading, box_max, box_rng)

        current_row()

        # last row: capacity in mAh and the resulting health percentage.  This
        # one hugs its title (its title is long, so it does not join the shared
        # columns) and the health value carries its own key.
        self._capacity_row()
        page.add(self.group_status)

        # ---- chart: one overlaid rolling chart, no data kept after closing ----
        self.chart = LiveChart()
        ui = load_ui()
        saved = [k for k in (ui.get("metrics") or []) if k in METRIC_KEYS]
        self.chart.selected = saved or list(DEFAULT_METRICS)
        self.chart.window_secs = ui.get("window") if ui.get("window") in (
            w[1] for w in WINDOWS) else 60

        g_chart = Adw.PreferencesGroup(title=_("指标"))
        # one control row: the metric buttons against the left edge, the window
        # selector against the right
        row_ctl = Adw.ActionRow()
        row_ctl.add_css_class("compact-status")
        # the metric buttons and the window selector are sized by scale_css(),
