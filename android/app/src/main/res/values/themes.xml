<resources>
    <!-- A window with no action bar: the whole UI is Compose.  Colours come
         from the Material 3 scheme in Theme.kt, not from here. -->
    <style name="Theme.Chargecap" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <color name="window_background">#FFFBFE</color>
    <!-- the adaptive icon's background layer: the icon's green battery needs a
         plain, light plate behind it -->
    <color name="ic_launcher_background">#FFFFFF</color>
</resources>
